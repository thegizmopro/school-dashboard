{
  "name": "Harmony Today — earthy / outdoor-ed",
  "version": "1.0",
  "date": "2026-09-03",
  "note": "Values as used in the approved mockups (option 1a / 2a / 2b). Hex is authoritative; oklch given for interpolation if you need intermediate tints.",

  "color": {
    "paper":        { "hex": "#F6F1E4", "use": "page background" },
    "card":         { "hex": "#FFFDF7", "use": "raised card background" },
    "card-alt":     { "hex": "#EFE9D9", "use": "footer zone background" },
    "ink":          { "hex": "#22301F", "use": "primary text, headings" },
    "ink-body":     { "hex": "#3B4A37", "use": "body text on tinted fills" },
    "ink-soft":     { "hex": "#5A6B54", "use": "secondary text, notice bodies" },
    "ink-muted":    { "hex": "#6B7A63", "use": "captions, event times" },
    "ink-faint":    { "hex": "#8A9280", "use": "timestamps" },
    "ink-ghost":    { "hex": "#A39A83", "use": "update stamp, expired listings" },
    "garden":       { "hex": "#3F7A43", "use": "primary action, links, hero gradient start" },
    "garden-deep":  { "hex": "#2C5A34", "use": "brand wordmark, hero gradient end" },
    "garden-pale":  { "hex": "#E7EEDF", "use": "info fills, community/shARK cards" },
    "garden-line":  { "hex": "#CFDCC4", "use": "border on garden-pale fills" },
    "clay":         { "hex": "#C2643B", "use": "alerts, theme-day callout, shARK event tag" },
    "clay-pale":    { "hex": "#F1E6DC", "use": "WhatsApp source chip fill" },
    "clay-line":    { "hex": "#E4BCA6", "use": "shARK tag border" },
    "clay-ink":     { "hex": "#8A4A28", "use": "WhatsApp source chip text" },
    "sun":          { "hex": "#E8A33D", "use": "countdown chip, no-school accent bar" },
    "sun-ink":      { "hex": "#33260C", "use": "text on sun" },
    "oat":          { "hex": "#F1E9D6", "use": "no-school day cards" },
    "oat-line":     { "hex": "#E0D3AE", "use": "border on oat" },
    "oat-ink":      { "hex": "#6B5520", "use": "text on oat" },
    "oat-ink-soft": { "hex": "#8A7B4E", "use": "secondary text on oat" },
    "sky":          { "hex": "#6E9BC2", "use": "event accent bar" },
    "sky-pale":     { "hex": "#E3EAF2", "use": "Email source chip fill" },
    "sky-ink":      { "hex": "#3C5A78", "use": "Email source chip text" },
    "iris":         { "hex": "#8E7CB0", "use": "conference / school-business accent bar" },
    "line":         { "hex": "#DCD3BE", "use": "card borders, dividers on paper" },
    "line-soft":    { "hex": "#EDE5D2", "use": "in-card dividers" },
    "placeholder-line": { "hex": "#C3B896", "use": "dashed sponsor slot border" },
    "bezel":        { "hex": "#1C1B17", "use": "device frame only, not part of the UI" }
  },

  "gradient": {
    "hero": "linear-gradient(150deg, #3F7A43, #2C5A34)",
    "hero-phone": "linear-gradient(170deg, #3F7A43, #2C5A34)",
    "sponsor-slot": "repeating-linear-gradient(135deg, #F6F1E4 0 6px, #EFE7D2 6px 12px)"
  },

  "font": {
    "display": { "family": "'Baloo 2', system-ui, sans-serif", "weights": [700, 800], "use": "dates, card headings, menu names, countdowns" },
    "body":    { "family": "Karla, system-ui, sans-serif", "weights": [400, 500, 700], "use": "body copy, list rows, buttons" },
    "mono":    { "family": "'IBM Plex Mono', monospace", "weights": [500], "use": "kickers, timestamps, source chips, data provenance" },
    "source": "Google Fonts: Baloo+2:wght@500;600;700;800, Karla:wght@400;500;700, IBM+Plex+Mono:wght@400;500;600"
  },

  "type": {
    "phone": {
      "hero-date":      { "size": 46, "weight": 800, "font": "display", "leading": 0.95, "tracking": "-0.02em" },
      "hero-temp":      { "size": 27, "weight": 700, "font": "display" },
      "menu-name":      { "size": 30, "weight": 800, "font": "display", "leading": 1.1 },
      "card-heading":   { "size": 19, "weight": 700, "font": "display" },
      "callout":        { "size": 20, "weight": 700, "font": "display", "leading": 1.15 },
      "list-title":     { "size": 15, "weight": 700, "font": "body" },
      "body":           { "size": 13.5, "weight": 400, "font": "body", "leading": 1.5 },
      "chip":           { "size": 14, "weight": 500, "font": "body" },
      "caption":        { "size": 12.5, "weight": 400, "font": "body" },
      "kicker":         { "size": 10, "weight": 500, "font": "mono", "tracking": "0.18em", "case": "upper" },
      "provenance":     { "size": 9, "weight": 500, "font": "mono", "tracking": "0.1em", "case": "upper" }
    },
    "wall-tablet": {
      "hero-date":      { "size": 68, "weight": 800, "font": "display", "leading": 0.92 },
      "hero-temp":      { "size": 48, "weight": 700, "font": "display" },
      "menu-name":      { "size": 42, "weight": 800, "font": "display" },
      "card-heading":   { "size": 24, "weight": 700, "font": "display" },
      "list-title":     { "size": 19, "weight": 700, "font": "body" },
      "body":           { "size": 15.5, "weight": 400, "font": "body", "leading": 1.5 },
      "chip":           { "size": 19, "weight": 500, "font": "body" },
      "kicker":         { "size": 12, "weight": 500, "font": "mono", "tracking": "0.2em", "case": "upper" }
    },
    "laptop": {
      "hero-date":      { "size": 58, "weight": 800, "font": "display", "leading": 0.94 },
      "menu-name":      { "size": 36, "weight": 800, "font": "display" },
      "card-heading":   { "size": 21, "weight": 700, "font": "display" },
      "list-title":     { "size": 16, "weight": 700, "font": "body" },
      "body":           { "size": 14, "weight": 400, "font": "body", "leading": 1.55 }
    },
    "minimums": { "body": 13, "caption": 12, "mono": 9, "note": "Never set body copy below 13px. Wall tablet body floor is 15px." }
  },

  "space": { "scale": [4, 8, 10, 12, 14, 16, 20, 22, 26, 28, 40], "card-gutter": 14, "text-gutter": 20, "card-padding-phone": "18-20", "card-padding-large": "20 22" },

  "radius": { "chip": 14, "row": 18, "card": 22, "card-lg": 26, "pill": 999, "frame": 36, "note": "0 is never used in this direction." },

  "border": { "hairline": "1px solid #EDE5D2", "card": "1px solid #DCD3BE", "card-on-green": "1px solid #CFDCC4", "emphasis": "2px solid #C2643B" },

  "shadow": { "none": "Cards carry no shadow — separation is border plus fill. Device bezel shadow in the mockup is presentation only." },

  "accent-bar": { "width": 3, "width-large": 4, "height": 30, "radius": 2, "note": "Left rule on Coming-up rows. Color encodes event kind." },

  "event-kind-color": {
    "break":         "sun",
    "holiday":       "sun",
    "no_school":     "sun",
    "early_release": "clay",
    "conference":    "iris",
    "event":         "sky",
    "shark":         "clay",
    "milestone":     "garden"
  },

  "source-chip": {
    "parentsquare": { "fill": "garden-pale", "text": "garden-deep" },
    "whatsapp":     { "fill": "clay-pale",   "text": "clay-ink" },
    "email":        { "fill": "sky-pale",    "text": "sky-ink" },
    "website":      { "fill": "line-soft",   "text": "ink-soft" },
    "style": { "font": "mono", "size": 9, "tracking": "0.14em", "case": "upper", "padding": "3px 7px", "radius": 5 }
  },

  "target": { "tap-min": 44, "note": "Every mailto and nav link meets 44px in the mockups." },

  "breakpoint": {
    "phone":       { "width": 390, "layout": "single column, full-page scroll" },
    "wall-tablet": { "width": 1194, "height": 834, "layout": "two columns, fits one screen, no scroll" },
    "laptop":      { "width": 1440, "layout": "three columns + full-width footer zone" }
  }
}
